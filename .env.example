# Robinhood Chain mainnet — mirrors the operator .env (same values) except
# secrets, which are EMPTY placeholders here. Fill them locally; never commit
# the real .env.
# Paper is the safe default. Do not enable live until the smoke test passes.
# MODE=live additionally requires LIVE_TRADING_ENABLED=true, ZEROEX_API_KEY,
# ROBINHOOD_RPC_URL (production provider) and TRADER_PRIVATE_KEY — boot
# fails closed without all four.

# ------------------------------------------------------------
# CoinGecko (optional enrichment only — discovery stays DexPaprika)
# ------------------------------------------------------------
COINGECKO_API=

# Infura (preferred EVM RPCs; explicit EVM_RPC_URLS wins, public defaults last).
INFURA_API_KEY=

# dRPC load balancer (key in-path; beats Infura where mapped: bsc, robinhood).
DRPC_API_KEY=

# Per-chain RPC failover (second transport behind the primary above).
# Robinhood = GetBlock EU shared endpoint (dRPC stays primary).
EVM_RPC_FALLBACKS={"robinhood":"https://shared.eu-central-1.getblock.io/<your-getblock-token>/"}

MODE=paper
AUTO_ENTRY=true

# Optional DEXPaprika key
DEXPAPRIKA_BASE_URL=https://api.dexpaprika.com
DEXPAPRIKA_API_KEY=

# Strategy
POSITION_SIZE_USD=5
INITIAL_BALANCE_USD=12
# Paper friction: 100bps fee + 1% slippage per side (matches SHADOW_COST_MODEL
# NET_PNL_100BPS_1PCT) so paper equity is net of modeled costs, not gross.
PAPER_ENTRY_FEE_BPS=100
PAPER_EXIT_FEE_BPS=100
PAPER_SLIPPAGE_BPS=100
# Fixed modeled gas per paper fill (~5-10x real RH gas: deliberately brutal).
PAPER_GAS_PER_FILL_USD=0.50
# Flat haircut on every paper sell (live prints worse than trigger marks).
PAPER_EXIT_HAIRCUT_PCT=3
# Live-shadow simulation: quote, wait submit+confirm delays, re-quote, then
# fill from the fresh executable quote (min-output checked). Learned live
# latencies override the fixed delays once sampled.
PAPER_SUBMIT_DELAY_MS=150
PAPER_CONFIRM_DELAY_MS=600
PAPER_LATENCY_PERCENTILE=50
PAPER_QUOTE_TIMEOUT_MS=15000
PAPER_LATENCY_FILE=data/execution-latency.json
MAX_OPEN_POSITIONS=1
MAX_SAME_SYMBOL_OPEN=1
NEW_POOL_MIN_AGE_SEC=60
NEW_POOL_MAX_AGE_SEC=300
MIN_LIQUIDITY_USD=5000
MAX_LIQUIDITY_USD=100000
QUOTE_SYMBOLS=WETH,ETH
# ETH here means native-ETH-quoted pools (zero address on DexScreener),
# treated as the same venue quote because execution sells into native ETH.
DEX_IDS=uniswap
DISCOVERY_LIMIT=100
DEXPAPRIKA_MAX_RPM=14
ENTRY_CONFIRM_ENABLED=true
ENTRY_CONFIRM_DELAY_MS=3000
ENTRY_CONFIRM_MAX_PRICE_DROP_PCT=5
ENTRY_CONFIRM_MAX_LIQ_DROP_PCT=30
# Anti-scam quality gates: reject byte-identical venue liquidity across
# confirmation, sell-dominated 5m flow, and already-pumped 5m prints.
# 0 disables the ratio/pump gates; absent venue data skips the check.
ENTRY_STALENESS_REJECT=true
ENTRY_MIN_BUY_RATIO_5M=0.4
ENTRY_MAX_PUMP_PCT_5M=50
ENTRY_PAUSED_HOURS_UTC=
ONE_ENTRY_PER_POOL=true

# Exits: tuned to the observed Robinhood paper regime. These are not a profit guarantee.
TP1_PCT=30
TP1_SELL_PCT=25
TP2_PCT=60
TP2_SELL_PCT=25
TP3_PCT=100
TP3_SELL_PCT=25
INITIAL_STOP_PCT=15
EARLY_STOP_PCT=10
EARLY_STOP_WINDOW_S=180
BREAKEVEN_ARM_PCT=20
BREAKEVEN_BUFFER_PCT=3
BREAKEVEN_AFTER_TP1=true
TRAIL_ACTIVATION_PCT=30
TRAIL_CONFIRM_TICKS=1
TRAIL_DISTANCE_PCT=15
MAX_POSITION_AGE_MIN=60
DRAIN_LIQUIDITY_PCT=25
DEAD_LIQUIDITY_USD=25

# Safety / risk
TOKEN_SAFETY_ENABLED=true
TOKEN_SAFETY_BLOCK_REPEAT_SYMBOLS=true
ENTRY_QUOTE_MAX_DEVIATION_PCT=3
BREAKER_STOPS=3
BREAKER_WINDOW_MIN=30
BREAKER_PAUSE_MIN=30
EXPECTANCY_TRADES=50
# Low-frequency deployments (a few trades/day) prefer a wide window so the
# gate measures regime, not last-20 noise.
MAX_DAILY_LIVE_LOSS_USD=25
PAPER_DAILY_LOSS_LIMIT_USD=0

# DexScreener price tracking. Keep below the documented 300 rpm cap.
# 2s polling halves request rate vs 1s; exit granularity coarsens accordingly.
PRICE_POLL_MS=2000
DEXSCREENER_MAX_RPM=290
DEXSCREENER_PAIR_BATCH_SIZE=20

# RPC. For live mode this MUST be your production provider URL: leave this
# EMPTY so a missing value fails closed instead of silently using the
# rate-limited public endpoint (live mode refuses to boot without it).
# Robinhood lists Alchemy as the recommended infrastructure provider;
# paste your Alchemy HTTP endpoint here and keep a second provider as fallback.
# Public RPC (https://rpc.mainnet.chain.robinhood.com) is paper/testing only.
ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/<your-alchemy-key>
ROBINHOOD_RPC_FALLBACK_URL=https://lb.drpc.live/robinhood/<your-drpc-key>

# EVM RPC precedence: explicit EVM_RPC_URLS > DRPC_API_KEY > INFURA_API_KEY
# > built-in public defaults (paper/testing only, never live).
# EVM_RPC_URLS={"robinhood":"https://..."}

# 0x Swap API v2 (quote path: /swap/allowance-holder/quote)
ZEROEX_API_KEY=
LIVE_BUY_SLIPPAGE_BPS=100
LIVE_SELL_SLIPPAGE_BPS=300
LIVE_SELL_MAX_SLIPPAGE_BPS=500
LIVE_ORDER_TIMEOUT_MS=120000
LIVE_SELL_MAX_RETRIES=3
LIVE_MIN_ETH_RESERVE=0.003
LIVE_ORDER_RETENTION_DAYS=30

# Wallet. NEVER commit this value.
TRADER_PRIVATE_KEY=
LIVE_TRADING_ENABLED=false
LIVE_TEST_TRADE=false
# Smoke-test size in wei (default 100000000000000 = 0.0001 ETH) plus a 0.003
# ETH gas buffer required in the wallet before the test runs.
# LIVE_TEST_AMOUNT_WEI=100000000000000

# Persistence
RECOVERY_ENABLED=true
STATE_FILE=data/state.json
LIVE_ORDERS_FILE=data/live-orders.json
LIVE_POSITIONS_FILE=data/live-positions.json
LIVE_STATE_FILE=data/live-state.json
LIVE_KILL_FILE=data/live-kill-switch.json

# Analytics
ANALYTICS_ENABLED=true
DUCKDB_PATH=data/paper.duckdb
SNAPSHOT_INTERVAL_S=60

# Telegram
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_STARTUP_MESSAGE=true
TELEGRAM_ANNOUNCE_CANDIDATES=false
TELEGRAM_TRADE_UPDATES=false
